# 実機 E2E 用の環境。リポジトリ直下に `.env` としてコピーし、値を埋める。
#   source .env
# `.env` は .gitignore 済みであることを確認すること。
#
# 命名の注意:
#   - `TOTSUKA_` 接頭辞を使わない。認識されない TOTSUKA_* は子プロセスの stderr に
#     警告を出す仕様（ADR-0009）でノイズになる。
#   - `GH_TOKEN` / `GITHUB_TOKEN` を使わない。gh CLI がそちらを優先し、シェル全体の
#     認証が黙って差し替わる。

# --- 検証環境の場所 -------------------------------------------------------
export E2E_HOME="$HOME/.totsuka-e2e"

# ビルド済みの totsuka バイナリ（チェックアウトの絶対パス）
export E2E_TOTSUKA_BIN="$HOME/Workspace/code/github/tomoya-k31/totsuka/target/debug/totsuka"

# --- Slack: テスト駆動用 --------------------------------------------------
# driver アプリの User OAuth Token。被テストアプリのものとは別。
#   A: chat:write, reactions:write, channels:history, channels:read,
#      groups:history, groups:read, im:history, im:write
#   B: chat:write
export E2E_SLACK_A='xoxp-…'
export E2E_SLACK_B='xoxp-…'

# 検証に使うチャンネルと、両アカウントのメンバー ID
export E2E_SLACK_CHANNEL='C…'
export E2E_SLACK_USER_A='U…'   # 運用者本人（= plugins/slack.toml の target_user_id）
export E2E_SLACK_USER_B='U…'   # 送信者役
export E2E_SLACK_EMOJI='totsuka-test'   # trigger_reactions と一致させる

# --- Slack: 被テスト（totsuka 本体が使う）--------------------------------
# 1Password に置くなら plugins/slack.toml 側を `op://…` にして、ここは空のままでよい。
# `.env` に置くと、常駐プロセスをエージェントからも起動できる（トークンは平文になる）。
#export E2E_SLACK_USER_TOKEN='xoxp-…'
#export E2E_SLACK_APP_TOKEN='xapp-…'
#export E2E_SLACK_BOT_TOKEN='xoxb-…'

# --- GitHub ---------------------------------------------------------------
# ProjectsV2 の書き戻し（F-84）に project write が要る。
# gh の OAuth を流用する場合は先に `gh auth refresh -s project` を実行しておく。
export E2E_GH_TOKEN="$(gh auth token)"
export E2E_GH_OWNER='tomoya-k31'
export E2E_GH_PROJECT='7'                 # ProjectsV2 の番号
export E2E_GH_REPO_WEB='totsuka-sandbox-web'
export E2E_GH_REPO_CLI='totsuka-sandbox-cli'

# --- フック（完了検知の UDS）の Bearer ------------------------------------
# 値は何でもよい。totsuka が生成するフックスクリプトと UDS サーバが共有する。
export E2E_HOOK_TOKEN='change-me-to-a-random-string'

# --- 隔離された totsuka ---------------------------------------------------
# XDG を export してはいけない（gh が $XDG_CONFIG_HOME/gh を読むため、シェル全体の
# 認証が壊れる）。env で totsuka の起動時にだけ被せる。
tt() {
  env E2E_HOME="$E2E_HOME" \
      E2E_GH_TOKEN="$E2E_GH_TOKEN" \
      E2E_HOOK_TOKEN="$E2E_HOOK_TOKEN" \
      XDG_CONFIG_HOME="$E2E_HOME/cfg" \
      XDG_DATA_HOME="$E2E_HOME/data" \
      XDG_STATE_HOME="$E2E_HOME/state" \
      XDG_CACHE_HOME="$E2E_HOME/cache" \
      NO_COLOR=1 \
      "$E2E_TOTSUKA_BIN" "$@"
}
