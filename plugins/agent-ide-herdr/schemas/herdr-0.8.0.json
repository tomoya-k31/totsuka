        "state_labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokens": {
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
