            {
              "$ref": "#/schemas/request/$defs/AgentPromptWaitOptions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "target",
        "text"
      ],
      "type": "object"
    },
    "AgentPromptWaitOptions": {
      "properties": {
        "timeout_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "until": {
          "items": {
            "$ref": "#/schemas/request/$defs/AgentStatus"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AgentSendKeysParams": {
