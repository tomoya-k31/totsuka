  "delivery": {
    "endpoint": "interactivity",
    "content_type": "application/x-www-form-urlencoded",
    "payload": {
      "type": "view_submission",
      "user": {
        "id": "U_ME",
        "username": "tomoya"
      },
      "api_app_id": "A_APP",
      "team": {
        "id": "T_WS"
      },
      "view": {
        "id": "V0REJECT01",
        "type": "modal",
        "callback_id": "reject_reply_modal",
        "private_metadata": "{\"c\":\"C0LOBBY\",\"d\":\"draft-1\",\"r\":\"https://hooks.slack.com/actions/T_WS/1111/abcdef\",\"ts\":\"1757640000.000100\"}",
        "state": {
          "values": {
            "alt_reply": {
              "alt_text": {
                "type": "plain_text_input",
                "value": "木曜でお願いします"
              }
            },
            "send_alt": {
              "send": {
                "type": "checkboxes",
