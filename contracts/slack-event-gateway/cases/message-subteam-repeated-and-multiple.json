{
  "name": "message-subteam-repeated-and-multiple",
  "why": "同じグループ ID が 2 回出ても 1 つに畳まれ、異なる ID は**初出順**で並ぶこと。順序と重複を決めておかないと、消費側の比較が実装依存になる。",
  "delivery": {
    "endpoint": "events",
    "content_type": "application/json",
    "payload": {
      "token": "deprecated-verification-token",
      "team_id": "T_WS",
      "api_app_id": "A_APP",
      "type": "event_callback",
      "event_id": "Ev0001",
      "event_time": 1757640000,
      "event": {
        "type": "message",
        "channel": "C0LOBBY",
        "user": "U_SENDER",
        "ts": "1757640000.000100",
        "text": "<!subteam^S0ABCDEF> <!subteam^S0TEAMB|@team-b> 再掲 <!subteam^S0ABCDEF>"
      }
    }
  },
  "expect": [
    {
      "topic": "events",
      "identity": "message:C0LOBBY:1757640000.000100",
      "record": {
        "v": 1,
        "kind": "message",
        "channel": "C0LOBBY",
        "ts": "1757640000.000100",
        "thread_ts": null,
        "user": "U_SENDER",
        "flags": {
          "mentions_me": false
        },
        "subteam_ids": [
          "S0ABCDEF",
          "S0TEAMB"
        ],
        "received_at": "2026-09-13T00:00:00Z"
      }
    }
  ]
}
